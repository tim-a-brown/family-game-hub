rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// Game Night — Firestore security rules
//
// Model: single doc per PIN at /pins/{pinId}. Anyone who knows the 4-digit
// PIN can read/write — data is scoped by PIN-as-shared-secret.
//
// Reads and writes are gated separately:
//   - Reads just need the PIN format check. `request.resource.data` does
//     not exist on reads, so using hasOnly() here would deny every sign-in.
//   - Writes additionally validate the field allowlist.
//
// If you add a new top-level field in sync.js pushNow, also add it to the
// hasOnly(...) list below, or writes containing it will fail with
// "Missing or insufficient permissions".
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    match /pins/{pinId} {
      allow read: if pinId.matches('^[0-9]{4}$');

      // A PIN whose account moved to a new PIN (Change PIN) holds only {moved, updatedAt} and takes no more
      // writes, so a device still signed in with the old PIN can't fill it up again.
      allow write: if pinId.matches('^[0-9]{4}$')
        && !(resource != null && resource.data.get('moved', false) == true)
        && request.resource.data.keys().hasOnly([
          'hi',         // per-game high scores
          'gh',         // per-game history records
          'label',      // the account's name (the person this PIN belongs to)
          'labelAt',    // when that name last changed (the newest wins across devices)
          'bank',       // casino virtual currency
          'updatedAt',  // server timestamp
          'rklists',    // saved ranker lists
          'favs',       // favorited game hrefs
          'favsAt',     // last-modified timestamp for favs (conflict resolution)
          'lorcana',    // Lorcana saved decks + bookmarked cards
          'avatars',    // player avatars (choice + uploaded photos), by name
          'ghDel',      // deleted game-history record ids (so other devices drop them)
          'links',      // player links: this account's profile code + linked people
          'players',    // Frequent players edits (removed or added names, newest change wins)
          'prefs',      // settings (theme, sound, music, per-game defaults and options), newest change wins per setting
          'moved'       // set (with updatedAt only) on the old PIN when an account changes its PIN
        ]);
    }

    // Lorcana online tables: one doc per table, a 4-letter code. Two devices
    // (two PINs) share it: the table owner writes the game, the other writes
    // answers to choices. Same PIN-style model: knowing the code is access.
    match /lorcanaRooms/{code} {
      allow get: if code.matches('^[A-Z]{4}$');
      // the lobby lists open tables (small queries only)
      allow list: if request.query.limit <= 50;
      allow delete: if code.matches('^[A-Z]{4}$');
      allow create, update: if code.matches('^[A-Z]{4}$')
        && request.resource.data.keys().hasOnly([
          'host', 'guest', 'status', 'at', 'seq', 'owner',
          'st', 'defs', 'pr', 'an', 'w', 'by'
        ]);
    }

    // Chess online tables: one doc per table, a 4-letter code. Both devices
    // replay the same move list (UCI strings) and each appends its own moves.
    // Same model as lorcanaRooms: knowing the code is access.
    match /chessRooms/{code} {
      allow get: if code.matches('^[A-Z]{4}$');
      // the lobby lists open tables (small queries only)
      allow list: if request.query.limit <= 50;
      allow delete: if code.matches('^[A-Z]{4}$');
      allow create, update: if code.matches('^[A-Z]{4}$')
        && request.resource.data.keys().hasOnly([
          'host', 'guest', 'status', 'hw', 'game', 't0', 'moves',
          'result', 'offer', 'again', 'hb', 'at', 'by'
        ])
        && request.resource.data.get('moves', []).size() <= 1000;
    }

    // Online arcade tables (online.js; Centipede Chaos first): one doc per table, a 4-letter code. The doc
    // only lists the table (game, host name, a one-way tag of the host's link code, seats); the devices play
    // over WebRTC. The connection handshake (one offer, one answer) goes through the sig subcollection and is
    // deleted once read. Same model as lorcanaRooms: knowing the code is access.
    match /arcadeRooms/{code} {
      allow get, delete: if code.matches('^[A-Z]{4}$');
      allow list: if request.query.limit <= 50;
      allow create, update: if code.matches('^[A-Z]{4}$')
        && request.resource.data.keys().hasOnly(['game', 'host', 'status', 'n', 'max', 'info', 'at', 'v', 'by'])
        && request.resource.data.host.keys().hasOnly(['name', 'dev', 'lk']);
      match /sig/{id} {
        allow get, delete: if true;
        allow list: if request.query.limit <= 50;
        allow create: if id.matches('^[A-Za-z0-9_-]{6,48}$')
          && request.resource.data.keys().hasOnly(['to', 'from', 'k', 'd', 'at'])
          && request.resource.data.d is string && request.resource.data.d.size() < 30000;
      }
    }

    // Player profiles for linking: one doc per 6-character share code (name, avatar, ask, rejected game ids,
    // arcade initials and best arcade scores, casino bankroll),
    // with an inbox of games other people recorded with this player in them. Knowing the code is access, like a
    // PIN, but it reaches only this profile and its inbox, never the PIN's data.
    match /links/{code} {
      allow get, delete: if code.matches('^[A-HJ-NP-Z2-9]{6}$');
      allow create, update: if code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['name', 'avatar', 'ask', 'rejected', 'at', 'ini', 'hi', 'bank'])
        && (!('bank' in request.resource.data) || request.resource.data.bank is number);
      match /inbox/{id} {
        allow create, update: if id.matches('^[a-z0-9]{6,24}$')
          && request.resource.data.keys().hasOnly(['key', 'entry', 'from', 'by', 'at'])
          && request.resource.data.entry is string && request.resource.data.entry.size() < 200000;
        allow get, delete: if true;
        allow list: if request.query.limit <= 100;
      }
    }

    // Default deny — nothing else is accessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
