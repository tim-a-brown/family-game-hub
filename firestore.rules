rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// Game Night — Firestore security rules
//
// Model: a single document per PIN at /pins/{pinId}. Anyone who knows the
// 4-digit PIN can read and write to it. There is no per-user auth —
// data is scoped by PIN-as-shared-secret.
//
// Allowed fields are explicitly listed below. If you add a new top-level
// field to the sync schema (see sync.js pushNow), you MUST add it to the
// `hasOnly(...)` allowlist or writes containing that field will fail with
// "Missing or insufficient permissions".
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    match /pins/{pinId} {
      // Reads only need the PIN format check — `request.resource.data`
      // isn't available on reads, so using hasOnly here would break sign-in.
      allow read: if pinId.matches('^[0-9]{4}$');

      // Writes additionally validate the field allowlist.
      allow write: if pinId.matches('^[0-9]{4}$')
        && request.resource.data.keys().hasOnly([
          'hi',         // per-game high scores
          'gh',         // per-game history records
          'label',      // human-friendly name for this PIN
          'bank',       // casino virtual currency
          'updatedAt',  // server timestamp
          'rklists',    // saved ranker lists
          'favs'        // favorited game hrefs
        ]);
    }

    // Default deny — anything outside /pins/{pinId} is locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
