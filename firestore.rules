rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// Game Night — Firestore security rules
//
// Model: single doc per PIN at /pins/{pinId}. Anyone who knows the 4-digit
// PIN can read/write — data is scoped by PIN-as-shared-secret.
//
// Reads and writes are gated separately:
//   - Reads just need the PIN format check. `request.resource.data` does
//     not exist on reads, so using hasOnly() here would deny every sign-in.
//   - Writes additionally validate the field allowlist.
//
// If you add a new top-level field in sync.js pushNow, also add it to the
// hasOnly(...) list below, or writes containing it will fail with
// "Missing or insufficient permissions".
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    match /pins/{pinId} {
      allow read: if pinId.matches('^[0-9]{4}$');

      allow write: if pinId.matches('^[0-9]{4}$')
        && request.resource.data.keys().hasOnly([
          'hi',         // per-game high scores
          'gh',         // per-game history records
          'label',      // human-friendly name for this PIN
          'bank',       // casino virtual currency
          'updatedAt',  // server timestamp
          'rklists',    // saved ranker lists
          'favs',       // favorited game hrefs
          'favsAt',     // last-modified timestamp for favs (conflict resolution)
          'lorcana'     // Lorcana saved decks + bookmarked cards
        ]);
    }

    // Lorcana online tables: one doc per table, a 4-letter code. Two devices
    // (two PINs) share it: the table owner writes the game, the other writes
    // answers to choices. Same PIN-style model: knowing the code is access.
    match /lorcanaRooms/{code} {
      allow get: if code.matches('^[A-Z]{4}$');
      // the lobby lists open tables (small queries only)
      allow list: if request.query.limit <= 50;
      allow delete: if code.matches('^[A-Z]{4}$');
      allow create, update: if code.matches('^[A-Z]{4}$')
        && request.resource.data.keys().hasOnly([
          'host', 'guest', 'status', 'at', 'seq', 'owner',
          'st', 'defs', 'pr', 'an', 'w', 'by'
        ]);
    }

    // Default deny — nothing else is accessible.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
