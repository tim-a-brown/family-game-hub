rules_version = '2';
// Firebase Storage: only the Lorcana card-art backup lives here. Anyone can
// view it (it's public card art); only the deploy service account writes it.
service firebase.storage {
  match /b/{bucket}/o {
    match /lorcana/{path=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
